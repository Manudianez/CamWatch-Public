# Copia este archivo como .env y rellena los valores.

# Identificador que te da Statbate al registrar la aplicación.
STATBATE_CLIENT_ID=

# Nombre de la app (provisional).
APP_NAME=CamWatch

# Certificado para servir HTTPS en tu propio ordenador (ver README).
SSL_CERTFILE=localhost.pem
SSL_KEYFILE=localhost-key.pem

# Solo al alojar la app en internet: su dirección pública (HTTPS).
# En local no hace falta: se usa https://localhost:8443.
# PUBLIC_URL=https://tu-dominio.example

# Este archivo es opcional: la app funciona en tu ordenador sin él.
# Si quieres cambiar algo, cópialo como .env y edita los valores.

# Identificador con el que Statbate registró la aplicación (es público).
# STATBATE_CLIENT_ID=stripwatch

# Nombre de la app.
# APP_NAME=CamWatch

# Certificado HTTPS. Por defecto se usan localhost.pem y localhost-key.pem
# de la carpeta del proyecto (los que crea mkcert).
# SSL_CERTFILE=localhost.pem
# SSL_KEYFILE=localhost-key.pem

# Solo al alojar la app en internet: su dirección pública (HTTPS), que hay
# que pedir a Statbate que añada como dirección de retorno.
# PUBLIC_URL=https://tu-dominio.example
